# Paper wallet (USD quote). Risk dollar amounts below are 1%/3%/20% of this baseline.
PAPER_EQUITY=2000

# Public ccxt market data (no API keys required for paper).
EXCHANGE_ID=kraken
DEFAULT_SYMBOL=BTC/USD
DEFAULT_TIMEFRAME=1h

# Hard risk stops (execution layer). Fractions of current / peak / day-start equity.
PER_TRADE_PCT=0.01
DAILY_DD_PCT=0.03
TOTAL_DD_PCT=0.20

# Default market-order slippage used when a signal omits max_slippage_bps.
MAX_SLIPPAGE_BPS=5

# SQLite paper state (gitignored).
STATE_PATH=state/paper.sqlite

# SQLite dry-run state (gitignored). Separate from the paper book.
DRY_RUN_STATE_PATH=state/dry_run.sqlite

# SQLite live book (gitignored). Separate from paper and dry-run.
LIVE_STATE_PATH=state/live.sqlite

# Kraken spot, trade-only. quanttrading live reads these and refuses blanks or placeholders.
# Create the key with query funds and create/modify orders. Leave withdraw disabled.
# Put real values in .env only. .env is gitignored. Do not commit keys.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
